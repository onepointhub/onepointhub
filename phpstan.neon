includes:
  - vendor/larastan/larastan/extension.neon
  - vendor/nesbot/carbon/extension.neon

parameters:
  level: 9
  paths:
    - app/
  excludePaths:
    - app/Modules/*/database/*
    - app/Modules/*/tests/*
  databaseMigrationsPath:
    - database/migrations
    - app/Modules/*/database/migrations
